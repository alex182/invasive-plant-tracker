# Copy to .env and fill in to enable "Identify from photo" on the add-plant form.
# Get a free API key at https://my.plantnet.org/
PLANTNET_API_KEY=
PLANTNET_PROJECT=all

# Optional: set the initial admin account's credentials. If ADMIN_PASSWORD is left blank,
# a random password is generated and printed to the backend log once, the first time it
# boots with an empty users table. Neither var has any effect after the first admin account
# has been created.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
